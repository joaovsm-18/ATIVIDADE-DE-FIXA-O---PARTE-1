Algoritmo "Exercicio5"
Var
// Seção de Declarações das variáveis
   NOME_ESCOLA: CARACTER

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...

   ESCREVAl("Digite o nome da escola:")
   LEIA(NOME_ESCOLA)

   ESCREVA("Eu estudo na escola, ", NOME_ESCOLA)

Fimalgoritmo