Algoritmo "Exercicio16"
Var
// Seção de Declarações das variáveis 
  aresta,volume:real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
  Escreva("Digite o valor do comprimeto da aresta:")
  Leia(aresta)

  Volume<-aresta^3
  Escreva("O volume do cubo e:",Volume)
Fimalgoritmo