Algoritmo "Exercicio2"
Var
// Seção de Declarações das variáveis 
 valor1, valor2, valor3, valor4, soma, media: real
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 

 Leia(valor1, valor2 )
 Leia(valor3, valor4)
 
 soma <- valor1 + valor2 + valor3 + valor4
 
 media <- soma/4
 
 escreval("resultado S:", soma)
 escreval("resultado M:", media)
Fimalgoritmo
